[resource]
script = ExtResource("1_item")
id = &"tent"
display_name = "Lều"
description = "Lều vải gấp gọn. Dùng để dựng tại chỗ đứng (đất trống), ngủ qua đêm ngoài trời. Thu lại được."
icon = ExtResource("3_icon")
category = 2
max_stack = 1
sell_price = 30
tags = Array[StringName]([&"camp"])
deploy_scene = ExtResource("4_tent")
max_per_map = 1
